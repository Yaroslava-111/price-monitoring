# Шаблон переменных окружения для «Ценового мониторинга».
# Здесь только имена — значений нет.
# Внимание: Streamlit НЕ подгружает .env автоматически. Эти переменные
# нужно задать в переменных окружения ОС (или в скрипте запуска), если они нужны.

# Путь к файлу базы данных вместо стандартного db/monitoring.db.
MONITORING_DB=

# Прокси-переменные (если доступ в интернет идёт через прокси).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Остальные параметры (пороги сопоставления, ИИ-агент, Telegram)
# задаются в приложении на экране «Настройки» и хранятся в БД,
# а не в переменных окружения. Их ключи для справки (без значений):
# auto_threshold
# manual_threshold
# deviation_threshold_pct
# agent_endpoint
# agent_key
# agent_model
# telegram_bot_token
# telegram_chat_id
# telegram_alert_threshold_pct