# Шаблон переменных окружения для «Ценового мониторинга».
# Здесь только имена — значений нет.
# Приложение читает этот файл при запуске (встроенный загрузчик, без
# дополнительных библиотек). Уже заданные переменные ОС не перетираются.

# Путь к файлу базы данных вместо стандартного db/monitoring.db.
MONITORING_DB=

# Секреты. Если переменная задана — она имеет приоритет над экраном
# «Настройки», значение в базу не пишется.
# API-ключ ИИ-агента.
MONITORING_AGENT_API_KEY=
# Токен Telegram-бота (от @BotFather).
MONITORING_TELEGRAM_BOT_TOKEN=

# Прокси-переменные (если доступ в интернет идёт через прокси).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Остальные параметры (пороги сопоставления, эндпоинт и модель агента,
# chat_id, порог уведомлений) задаются в приложении на экране «Настройки»
# и хранятся в БД, а не в переменных окружения. Их ключи для справки
# (без значений):
# auto_threshold
# manual_threshold
# deviation_threshold_pct
# agent_endpoint
# agent_model
# telegram_chat_id
# telegram_alert_threshold_pct